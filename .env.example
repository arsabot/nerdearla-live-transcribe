# ============================================================================
# Nerdearla Live - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ============================================================================

# --- Server Port ---
PORT=3000

# --- Authentication ---

# Password for accessing the app. Required when AUTH_ENABLED=true.
APP_PASSWORD=change-me

# Enable/disable password login (default: true).
# Set to false to allow anonymous access (useful behind VPN/reverse proxy auth).
AUTH_ENABLED=true

# Separate signing secret for auth cookies (defaults to APP_PASSWORD if empty).
AUTH_SECRET=change-me-too

# Auth cookie name.
AUTH_COOKIE_NAME=srlt_auth

# Auth token TTL in seconds (default: 43200 = 12 hours).
AUTH_TOKEN_TTL_SECONDS=43200

# Force cookie Secure flag (default: auto-detect from request scheme).
# Set to true when behind HTTPS reverse proxy that strips the scheme.
AUTH_COOKIE_SECURE=true

# --- Origins ---

# Restrict allowed WebSocket origins (comma-separated).
# If empty, origin host must match the request Host header.
# ALLOWED_ORIGINS=https://translator.example.com,https://www.translator.example.com
ALLOWED_ORIGINS=

# --- STT Engines ---

# Which engines are available to users. Comma-separated.
# Valid: webspeech, whisper, nemotron, deepgram, elevenlabs, gemini_live
# whisper     = browser-local ONNX (no API key; first run downloads model from Hugging Face)
# gemini_live = Gemini 3.5 Live direct audio streaming & translation
# nemotron    = browser-local NVIDIA Nemotron-3.5-ASR streaming ONNX (no API key; WebGPU
#               recommended). Build the model first — see app/static/nemotron/README.md.
# Disabled engines appear grayed out in the UI.
ENABLED_ENGINES=webspeech,whisper,gemini_live,deepgram,elevenlabs

# When "nemotron" is enabled, create app/static/nemotron/models and build missing
# model assets on container start. First run downloads ~2.6 GB and writes ~1.3 GB.
NEMOTRON_AUTO_PREPARE=true

# Max seconds for the Nemotron model preparation step (0 disables the timeout).
NEMOTRON_PREPARE_TIMEOUT_SECONDS=1800

# --- Deepgram ---

# API key from https://console.deepgram.com/
# Required when "deepgram" is in ENABLED_ENGINES.
DEEPGRAM_API_KEY=

# Internal queue size for Deepgram transcription results (default: 100).
DEEPGRAM_RESULT_QUEUE_SIZE=100

# --- ElevenLabs ---

# API key from https://elevenlabs.io/app/settings/api-keys
# Required when "elevenlabs" is in ENABLED_ENGINES (server mode).
# In browser mode users can also provide their own key in the UI.
ELEVENLABS_API_KEY=

# --- Translation Providers & Conference Settings ---

# Translation provider: "googletrans" (default) or "gemini"
TRANSLATION_PROVIDER=googletrans

# Google Gemini API key (optional, used when TRANSLATION_PROVIDER=gemini or engine gemini_live)
GEMINI_API_KEY=

# Gemini Live Model default (e.g. gemini-3.5-live-translate-preview or gemini-3.8-live)
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Max accepted input text length per message (default: 5000).
MAX_TEXT_LENGTH=5000

# Timeout for a single translation call in seconds (default: 10).
TRANSLATE_TIMEOUT_SECONDS=10

